# After a branch checkout: ensure .ai/work/<slug> and GC orphaned note dirs.
# Requires: git config core.hooksPath .githooks

set -euo pipefail

# post-checkout args: <prev-HEAD> <new-HEAD> <branch-checkout-flag>
flag="${3:-0}"
if [ "$flag" != "1" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
exec "${ROOT}/scripts/ai-notes-gc.sh" --checkout
